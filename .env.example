# Copy this file to .env.local and fill in what you have.
# Everything here is optional for local development. In production SESSION_SECRET
# is required, and paid plans stay locked until Stripe (or Solana) is configured.

# Signs login sessions and one-shot email/OAuth tokens. REQUIRED in production:
# at least 32 random characters, e.g. the output of `openssl rand -base64 48`.
# The server refuses to sign or read sessions in production without it.
SESSION_SECRET=

# First admin in production (no demo/admin accounts are seeded there). Used only
# when no admin exists yet; remove ADMIN_PASSWORD once you've signed in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set SEED_DEMO=1 only for a public demo deployment that should get demo data.
SEED_DEMO=
# Set ALLOW_DEMO_BILLING=1 only on a demo deployment: it lets anyone switch to a
# paid plan without paying when Stripe isn't configured.
ALLOW_DEMO_BILLING=

# Public URL of this app (used in links and QR codes). No trailing slash.
# OAuth redirect URIs are built from this value, so it must match the host you
# open the app on.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain-ish labels shown on printed links. Cosmetic only in the clone.
NEXT_PUBLIC_SHORT_DOMAIN=rkns.link
NEXT_PUBLIC_BIO_DOMAIN=rkns.me

# --- Stripe (test mode; only needed to exercise real checkout) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_LIFETIME=

# --- Email sending (optional). Without it, email steps still record subscribers
#     and the app shows export + copyable links. Password reset and email
#     verification links are printed in the UI instead of being mailed. ---
RESEND_API_KEY=
EMAIL_FROM=hello@yourdomain.com

# --- Social sign-in (optional). Each provider needs BOTH values or its button
#     stays disabled on /login and /register.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web):
#   Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/callback
#    e.g. http://localhost:3000/api/auth/oauth/callback
#          https://yourdomain.com/api/auth/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Discord Developer Portal → Application → OAuth2:
#   Redirect: ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/callback
#   Scopes:   identify email
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Meta / Instagram (for native DM automation) ---
# Both are required in production: the verify token for webhook setup, and the
# app secret (Meta app dashboard → Settings → Basic) to check X-Hub-Signature-256
# on every delivery. Without the secret, production rejects all webhook calls.
META_VERIFY_TOKEN=
META_APP_SECRET=

